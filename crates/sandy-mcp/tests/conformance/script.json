{
  "name": "primary-t3 stand-in",
  "description": "One fixed script run against any sandy-mcp: the fake broker (tier-2) and, later, a real broker (tier-3). Pointers are RFC 6901. A string value `$name` is a captured value.",
  "steps": [
    { "tool": "list", "args": {}, "expect": { "present": ["/jobs"] } },
    {
      "tool": "submit",
      "args": {
        "manifest": "AA==",
        "manifest_encoding": "conformance.v1",
        "required_isolation_class": "untrusted"
      },
      "capture": { "job": "/job_id" },
      "expect": { "equals": { "/state": "pending" } }
    },
    {
      "tool": "status",
      "args": { "job_id": "$job" },
      "expect": { "equals": { "/job_id": "$job" } }
    },
    {
      "tool": "attach",
      "args": { "job_id": "$job" },
      "expect": { "present": ["/stream_url"] }
    },
    {
      "tool": "cancel",
      "args": { "job_id": "$job" },
      "expect": { "equals": { "/state": "cancelled" } }
    },

    {
      "tool": "spawn_environment",
      "args": {
        "request_id": "conf-1",
        "profile": "harness",
        "lifetime": { "kind": "ephemeral", "ttl_secs": 600 },
        "task_ref": "conf"
      },
      "capture": { "env": "/environment_id" },
      "expect": { "equals": { "/state": "provisioning" } }
    },
    {
      "note": "O1: a retry with the same request_id and payload returns the same environment",
      "tool": "spawn_environment",
      "args": {
        "request_id": "conf-1",
        "profile": "harness",
        "lifetime": { "kind": "ephemeral", "ttl_secs": 600 },
        "task_ref": "conf"
      },
      "expect": { "equals": { "/environment_id": "$env" } }
    },
    {
      "note": "AT-9: the same request_id with another payload is a typed conflict",
      "tool": "spawn_environment",
      "args": {
        "request_id": "conf-1",
        "profile": "other",
        "lifetime": { "kind": "ephemeral", "ttl_secs": 600 }
      },
      "expect": { "ok": false, "code": "request_id_conflict" }
    },
    {
      "note": "O3: no connection before Ready",
      "tool": "get_environment",
      "args": { "environment_id": "$env" },
      "expect": {
        "equals": { "/state": "provisioning" },
        "absent": ["/connection"]
      }
    },
    {
      "note": "O2: Ready only after the probe; then the connection appears",
      "tool": "get_environment",
      "args": { "environment_id": "$env" },
      "until": { "/state": "ready" },
      "max_polls": 10,
      "expect": { "present": ["/connection/url"] }
    },
    {
      "note": "O9: an ephemeral environment cannot be paused",
      "tool": "stop_environment",
      "args": { "environment_id": "$env" },
      "expect": { "ok": false, "code": "unsupported_for_lifetime" }
    },
    {
      "note": "open point 1: no external link interface yet",
      "tool": "link_environment",
      "args": { "environment_id": "$env", "primary": "primary" },
      "expect": { "equals": { "/link_status": "unsupported" } }
    },
    {
      "note": "O6: delete is idempotent",
      "tool": "delete_environment",
      "args": { "environment_id": "$env" },
      "expect": { "equals": { "/state": "deleted" } }
    },
    {
      "tool": "delete_environment",
      "args": { "environment_id": "$env" },
      "expect": { "equals": { "/state": "deleted" } }
    }
  ]
}
